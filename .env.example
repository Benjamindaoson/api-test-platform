# --- DeepAgents Backend ---
# Options: state | local_shell | composite
BACKEND_TYPE=local_shell
# Absolute path the agent will treat as its working root (default: current directory)
BACKEND_ROOT_DIR=/path/to/your/project
# Treat BACKEND_ROOT_DIR as a virtual root; blocks '..' and absolute paths outside it.
# On Windows local development this is often confusing, so default to false here.
BACKEND_VIRTUAL_MODE=false
# Shell command timeout in seconds
BACKEND_TIMEOUT=120
# Inherit the parent process environment (PATH, etc.) for shell commands
BACKEND_INHERIT_ENV=true

# --- AI Model ---
MODEL_PROVIDER=openai
MODEL_NAME=deepseek-v4-pro
# Or use local LLM:
# MODEL_PROVIDER=ollama
# MODEL_NAME=qwen2.5:14b

# --- API Keys ---
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.deepseek.com/v1

# --- CodeGraph ---
CODEGRAPH_PATH=codegraph
CODEGRAPH_DEFAULT_PROJECT=/path/to/your/project

# --- API Test Workspace ---
# Where generated pytest scripts and test reports are written
API_TEST_DIR=/path/to/your/project/workspace/test_suites

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=api_test_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Server ---
API_HOST=0.0.0.0
API_PORT=8100
LANGGRAPH_PORT=8200